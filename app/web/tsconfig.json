{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "../packages/contracts/src/audit.ts",
    "../packages/contracts/test/audit-fixture.ts",
    "vite.config.ts",
    "../packages/contracts/src/multipart-cleanup.ts",
    "../packages/contracts/test/multipart-cleanup-fixture.ts",
    "../packages/contracts/src/amortization.ts",
    "../packages/contracts/src/finance-reports.ts",
    "../packages/contracts/src/finance-fx.ts",
    "../packages/contracts/test/amortization-fixture.ts",
    "../packages/contracts/test/amortization-cases.ts",
    "../packages/contracts/test/notification-retry-fixture.ts",
    "../packages/contracts/src/notifications.ts"
  ]
}

# Development examples only. Production must supply external PostgreSQL and secrets.
CP_ENV=development
CP_HTTP_ADDR=127.0.0.1:8080
CP_PUBLIC_ORIGIN=http://localhost:5173
CP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8080
CP_DATABASE_URL=postgres://copypaste_app:CHANGE_ME@127.0.0.1:55432/copypaste?sslmode=disable
CP_MIGRATION_DATABASE_URL=postgres://copypaste_migrator:CHANGE_ME@127.0.0.1:55432/copypaste?sslmode=disable
CP_CURSOR_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
CP_MFA_KEY=GENERATE_BASE64_ENCODED_32_RANDOM_BYTES
CP_STORAGE_DRIVER=disabled
CP_OSS_ENDPOINT=
CP_OSS_REGION=
CP_OSS_BUCKET=
CP_R2_ENDPOINT=
CP_R2_BUCKET=
# API process: provide only its signer and inspector identities.
CP_OSS_UPLOAD_SIGNER_ACCESS_KEY_ID=
CP_OSS_UPLOAD_SIGNER_ACCESS_KEY_SECRET=
CP_OSS_UPLOAD_SIGNER_SESSION_TOKEN=
CP_OSS_UPLOAD_INSPECTOR_ACCESS_KEY_ID=
CP_OSS_UPLOAD_INSPECTOR_ACCESS_KEY_SECRET=
CP_OSS_UPLOAD_INSPECTOR_SESSION_TOKEN=
CP_R2_UPLOAD_SIGNER_ACCESS_KEY_ID=
CP_R2_UPLOAD_SIGNER_ACCESS_KEY_SECRET=
CP_R2_UPLOAD_SIGNER_SESSION_TOKEN=
CP_R2_UPLOAD_INSPECTOR_ACCESS_KEY_ID=
CP_R2_UPLOAD_INSPECTOR_ACCESS_KEY_SECRET=
CP_R2_UPLOAD_INSPECTOR_SESSION_TOKEN=
# worker-upload process: separate environment, no API/MFA/model secrets.
CP_OSS_UPLOAD_LIFECYCLE_ACCESS_KEY_ID=
CP_OSS_UPLOAD_LIFECYCLE_ACCESS_KEY_SECRET=
CP_OSS_UPLOAD_LIFECYCLE_SESSION_TOKEN=
CP_R2_UPLOAD_LIFECYCLE_ACCESS_KEY_ID=
CP_R2_UPLOAD_LIFECYCLE_ACCESS_KEY_SECRET=
CP_R2_UPLOAD_LIFECYCLE_SESSION_TOKEN=
# worker-verify-small / worker-verify-large: read-only fixed-source identity.
CP_OSS_UPLOAD_VERIFY_ACCESS_KEY_ID=
CP_OSS_UPLOAD_VERIFY_ACCESS_KEY_SECRET=
CP_OSS_UPLOAD_VERIFY_SESSION_TOKEN=
CP_R2_UPLOAD_VERIFY_ACCESS_KEY_ID=
CP_R2_UPLOAD_VERIFY_ACCESS_KEY_SECRET=
CP_R2_UPLOAD_VERIFY_SESSION_TOKEN=
# Explicit scanning policy. Disabled blocks publication; never implies clean.
CP_SCAN_DRIVER=disabled
CP_CLAMD_NETWORK=tcp
CP_CLAMD_ADDRESS=127.0.0.1:3310
CP_SCAN_MAX_BYTES=
CP_SCAN_TIMEOUT_SECONDS=
CP_SCAN_POLICY_SHA256=
CP_SCAN_LIMITS_ATTESTED=false
# Promotion workers receive only their source reader and candidate target roles.
CP_OSS_PROMOTE_SOURCE_ACCESS_KEY_ID=
CP_OSS_PROMOTE_SOURCE_ACCESS_KEY_SECRET=
CP_OSS_PROMOTE_SOURCE_SESSION_TOKEN=
CP_OSS_PROMOTE_TARGET_ACCESS_KEY_ID=
CP_OSS_PROMOTE_TARGET_ACCESS_KEY_SECRET=
CP_OSS_PROMOTE_TARGET_SESSION_TOKEN=
CP_R2_PROMOTE_SOURCE_ACCESS_KEY_ID=
CP_R2_PROMOTE_SOURCE_ACCESS_KEY_SECRET=
CP_R2_PROMOTE_SOURCE_SESSION_TOKEN=
CP_R2_PROMOTE_TARGET_ACCESS_KEY_ID=
CP_R2_PROMOTE_TARGET_ACCESS_KEY_SECRET=
CP_R2_PROMOTE_TARGET_SESSION_TOKEN=
# Replica workers: source role on selected primary, target role on other cloud.
CP_OSS_REPLICA_SOURCE_ACCESS_KEY_ID=
CP_OSS_REPLICA_SOURCE_ACCESS_KEY_SECRET=
CP_OSS_REPLICA_SOURCE_SESSION_TOKEN=
CP_OSS_REPLICA_TARGET_ACCESS_KEY_ID=
CP_OSS_REPLICA_TARGET_ACCESS_KEY_SECRET=
CP_OSS_REPLICA_TARGET_SESSION_TOKEN=
CP_R2_REPLICA_SOURCE_ACCESS_KEY_ID=
CP_R2_REPLICA_SOURCE_ACCESS_KEY_SECRET=
CP_R2_REPLICA_SOURCE_SESSION_TOKEN=
CP_R2_REPLICA_TARGET_ACCESS_KEY_ID=
CP_R2_REPLICA_TARGET_ACCESS_KEY_SECRET=
CP_R2_REPLICA_TARGET_SESSION_TOKEN=

# API download roles; independent of CP_STORAGE_DRIVER. No implicit fallback.
CP_DOWNLOAD_PROVIDERS=disabled
CP_OSS_DOWNLOAD_SIGNER_ACCESS_KEY_ID=
CP_OSS_DOWNLOAD_SIGNER_ACCESS_KEY_SECRET=
CP_OSS_DOWNLOAD_SIGNER_SESSION_TOKEN=
CP_OSS_DOWNLOAD_READER_ACCESS_KEY_ID=
CP_OSS_DOWNLOAD_READER_ACCESS_KEY_SECRET=
CP_OSS_DOWNLOAD_READER_SESSION_TOKEN=
CP_R2_DOWNLOAD_SIGNER_ACCESS_KEY_ID=
CP_R2_DOWNLOAD_SIGNER_ACCESS_KEY_SECRET=
CP_R2_DOWNLOAD_SIGNER_SESSION_TOKEN=
CP_R2_DOWNLOAD_READER_ACCESS_KEY_ID=
CP_R2_DOWNLOAD_READER_ACCESS_KEY_SECRET=
CP_R2_DOWNLOAD_READER_SESSION_TOKEN=

# Optional AI text processing: independent streaming identities, never download signers.
CP_AGENT_FILE_PROVIDERS=disabled
CP_OSS_AGENT_FILE_READER_ACCESS_KEY_ID=
CP_OSS_AGENT_FILE_READER_ACCESS_KEY_SECRET=
CP_OSS_AGENT_FILE_READER_SESSION_TOKEN=
CP_R2_AGENT_FILE_READER_ACCESS_KEY_ID=
CP_R2_AGENT_FILE_READER_ACCESS_KEY_SECRET=
CP_R2_AGENT_FILE_READER_SESSION_TOKEN=
CP_AGENT_DRAFT_DRIVER=disabled
CP_OSS_AGENT_DRAFT_WRITER_ACCESS_KEY_ID=
CP_OSS_AGENT_DRAFT_WRITER_ACCESS_KEY_SECRET=
CP_OSS_AGENT_DRAFT_WRITER_SESSION_TOKEN=
CP_R2_AGENT_DRAFT_WRITER_ACCESS_KEY_ID=
CP_R2_AGENT_DRAFT_WRITER_ACCESS_KEY_SECRET=
CP_R2_AGENT_DRAFT_WRITER_SESSION_TOKEN=

# History restore worker; fixed committed reads and candidate writes use independent identities.
CP_OSS_RESTORE_SOURCE_ACCESS_KEY_ID=
CP_OSS_RESTORE_SOURCE_ACCESS_KEY_SECRET=
CP_OSS_RESTORE_SOURCE_SESSION_TOKEN=
CP_OSS_RESTORE_TARGET_ACCESS_KEY_ID=
CP_OSS_RESTORE_TARGET_ACCESS_KEY_SECRET=
CP_OSS_RESTORE_TARGET_SESSION_TOKEN=
CP_R2_RESTORE_SOURCE_ACCESS_KEY_ID=
CP_R2_RESTORE_SOURCE_ACCESS_KEY_SECRET=
CP_R2_RESTORE_SOURCE_SESSION_TOKEN=
CP_R2_RESTORE_TARGET_ACCESS_KEY_ID=
CP_R2_RESTORE_TARGET_ACCESS_KEY_SECRET=
CP_R2_RESTORE_TARGET_SESSION_TOKEN=

CP_AGENT_RUNTIME_URL=
CP_AGENT_RUNTIME_TOKEN=
# Optional ingress only. JSON array with bot_id, organization_id, username,
# webhook_secret (32-256 letters/digits/_/-). No outbound Bot API token is used.
CP_TELEGRAM_INGRESS=disabled

# Optional contract reminders for worker-notification. Blank disables scheduling;
# in-app delivery of other committed events remains enabled. Set all three to
# an explicitly selected company organization/timezone/comma-separated lead days.
CP_NOTIFICATION_CONTRACT_ORG_ID=
CP_NOTIFICATION_CONTRACT_TIMEZONE=
CP_NOTIFICATION_CONTRACT_DAYS_BEFORE=

# worker-telegram uses bot/organization identities only; no webhook or Bot API secrets.
CP_TELEGRAM_DISPATCH_BOTS=disabled

# worker-telegram-delivery only. Use a separate restricted environment file.
# JSON array: bot_id, organization_id, token (that bot's Bot API token),
# portal_origin (HTTPS origin without a path/trailing slash/query/fragment).
# Requires a separately MFA-enabled portal_only channel. No business text is sent.
CP_TELEGRAM_DELIVERY_BOTS=disabled

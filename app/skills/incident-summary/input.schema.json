{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copypaste.hk/schemas/company-skills/incident-summary.input.v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 30,
          "minItems": 1,
          "uniqueItems": true
        },
        "window": {
          "$ref": "https://copypaste.hk/schemas/company-skills/common.v1.json#/$defs/window"
        },
        "focus": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "service_ids",
        "window"
      ]
    },
    {
      "$ref": "https://copypaste.hk/schemas/company-skills/common.v1.json#/$defs/conversation_input"
    }
  ]
}

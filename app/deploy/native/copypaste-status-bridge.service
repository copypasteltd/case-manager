[Unit]
Description=CopyPaste signed Prometheus Blackbox observation bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copypaste-monitor
Group=copypaste-monitor
WorkingDirectory=/opt/copypaste
ExecStart=/opt/copypaste/bin/status-bridge --config /etc/copypaste/status-bridge.json
StateDirectory=copypaste-status-bridge
StateDirectoryMode=0700
ReadWritePaths=/var/lib/copypaste-status-bridge
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target

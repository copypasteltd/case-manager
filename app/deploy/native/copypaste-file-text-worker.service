[Unit]
Description=CopyPaste fixed-version file text extraction worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copypaste-worker
Group=copypaste-worker
WorkingDirectory=/opt/copypaste/app
EnvironmentFile=/etc/copypaste/file-text-worker.env
ExecStart=/opt/copypaste/bin/platform worker-file-text
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

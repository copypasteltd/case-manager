# Native Linux candidate only. Instances: small or large. Not installed.
[Unit]
Description=CopyPaste immutable candidate promotion worker (%i)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/copypaste/promote-%i.env

[Service]
Type=simple
User=copypaste-promote
Group=copypaste-promote
WorkingDirectory=/opt/copypaste/current
EnvironmentFile=/etc/copypaste/promote-%i.env
ExecStart=/opt/copypaste/current/bin/platform worker-promote-%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
CacheDirectory=copypaste-promote
ReadWritePaths=/var/cache/copypaste-promote

[Install]
WantedBy=multi-user.target

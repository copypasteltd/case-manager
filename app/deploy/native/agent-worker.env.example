# Set the actual restricted worker DB URL through private operator configuration.
CP_ENV=production
CP_DATABASE_URL=
CP_AGENT_LAUNCHER=/opt/copypaste/bin/agent-native-launch
CP_AGENT_NODE=/usr/bin/node
CP_AGENT_ENTRY=/opt/copypaste/runtime-release/app/agent-runtime/dist/worker.js
CP_AGENT_REPOSITORY=/opt/copypaste/runtime-release
CP_AGENT_WORK_DIRECTORY=/var/lib/copypaste/agent-work
CP_AGENT_PROOF_COMMAND=/opt/copypaste/bin/agent-native-probe
CP_AGENT_PROOF_PUBLIC_KEY=
CP_AGENT_MODEL=operator-selected-model
CP_AGENT_MODEL_GATEWAY=native
CP_AGENT_MODEL_BASE_URL=http://127.0.0.1:18082/v1
CP_AGENT_CODEX_EXECUTABLE=/opt/copypaste/bin/codex
CP_AGENT_BRIDGE_ADDRESS=127.0.0.1:18081
# Provider API keys belong only in the root broker's private model.key file.
CP_AGENT_OPENAI_API_KEY=
CP_AGENT_FILE_PROVIDERS=disabled
CP_AGENT_DRAFT_DRIVER=disabled

{
  "version": 1,
  "platform": {
    "url": "https://case.example.invalid",
    "allowed_ips": ["203.0.113.10"],
    "allow_private": false,
    "allow_http": false
  },
  "prometheus": {
    "url": "https://metrics.example.invalid",
    "allowed_ips": ["203.0.113.20"],
    "allow_private": false,
    "allow_http": false
  },
  "prometheus_bearer_file": "/etc/copypaste/status-keys/prometheus-readonly.token",
  "state_directory": "/var/lib/copypaste-status-bridge",
  "poll_seconds": 60,
  "max_sample_age_seconds": 180,
  "timeout_seconds": 10,
  "concurrency": 4,
  "targets": [
    {
      "source_id": "11111111-1111-4111-8111-111111111111",
      "source_revision_id": "22222222-2222-4222-8222-222222222222",
      "key_file": "/etc/copypaste/status-keys/service.seed",
      "job": "blackbox-production",
      "instance": "https://service.example.invalid/health",
      "labels": {"environment": "production"}
    }
  ]
}

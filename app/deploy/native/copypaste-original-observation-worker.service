[Unit]
Description=CopyPaste exact known upload HEAD observation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copypaste-observer
Group=copypaste-observer
WorkingDirectory=/opt/copypaste/app
EnvironmentFile=/etc/copypaste/original-observation-worker.env
ExecStart=/opt/copypaste/bin/platform worker-original-observation
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

[Unit]
Description=CopyPaste Telegram portal notification delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copypaste-worker
Group=copypaste-worker
WorkingDirectory=/opt/copypaste/app
EnvironmentFile=/etc/copypaste/telegram-delivery-worker.env
ExecStart=/opt/copypaste/bin/platform worker-telegram-delivery
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target

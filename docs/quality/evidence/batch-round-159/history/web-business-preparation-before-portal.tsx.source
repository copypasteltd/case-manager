import {useEffect,useRef,useState} from 'react';
import {Link} from 'react-router-dom';
import {useInfiniteQuery} from '@tanstack/react-query';
import {draftNames,type BusinessDraft,type DraftKind} from '@copypaste/contracts/business-drafts';
import {businessChanges,businessContent,businessRevisionReceipt,businessRoutes,makeBusinessRevision,preparedRevisionMatches,type BusinessRevision,type PreparedBusinessRevision,type PreparedDraftBody,type PreparedRevisionBody,type RevisionBasis} from '@copypaste/contracts/business-revisions';
import {api,type Me,type Page,type Schemas} from './api';
import {Dialog,ErrorNotice,Field} from './components';
import {ContractEditor} from './Contracts';
import {SpendEditor} from './SpendEditor';
import {SubscriptionEditor} from './SubscriptionEditor';

type BusinessRecord=Schemas['Contract']|Schemas['Spend']|Schemas['Subscription'];
function FieldChanges({before,after}:{before:unknown;after:unknown}){const rows=businessChanges(before,after);return <details open><summary>完整资料核对 · {rows.length}处变化</summary>{rows.length?<div className="table-scroll" style={{maxHeight:520,overflow:'auto'}}><table><thead><tr><th>资料项</th><th>修改前</th><th>本次固定资料</th></tr></thead><tbody>{rows.map((v,i)=><tr key={i}><th>{v.label}</th><td style={{whiteSpace:'pre-wrap',overflowWrap:'anywhere'}}>{v.before}</td><td style={{whiteSpace:'pre-wrap',overflowWrap:'anywhere'}}>{v.after}</td></tr>)}</tbody></table></div>:<p>商业资料没有变化，请核对是否需要建立新修订。</p>}</details>;}
function DraftEditor({kind,me,conversation,record,onPrepared,onClose}:{kind:DraftKind;me:Me;conversation:Schemas['Conversation'];record?:BusinessRecord;onPrepared(body:PreparedDraftBody|PreparedRevisionBody):Promise<void>;onClose():void}){
 const scope=record?undefined:{project_id:conversation.project_id,classification:conversation.classification};
 if(kind==='contract')return <ContractEditor me={me} contract={record as Schemas['Contract']|undefined} preparationScope={scope} onPrepared={onPrepared} onClose={onClose}/>;
 if(kind==='subscription')return <SubscriptionEditor subscription={record as Schemas['Subscription']|undefined} preparationScope={scope} onPrepared={onPrepared} onClose={onClose}/>;
 return <SpendEditor me={me} kind={kind} value={record as Schemas['Spend']|undefined} preparationScope={scope} onPrepared={onPrepared} onClose={onClose}/>;
}
export function CompleteBusinessDraft({conversation:c,me,disabled,onChange}:{conversation:Schemas['Conversation'];me:Me;disabled:boolean;onChange(v:BusinessDraft):void}){
 const[kind,setKind]=useState<DraftKind>('contract'),[editor,setEditor]=useState(false),[prepared,setPrepared]=useState<BusinessDraft>(),[reviewed,setReviewed]=useState(false),[error,setError]=useState<unknown>();
 const ticket=useRef(0),blocked=useRef(disabled);blocked.current=disabled;useEffect(()=>()=>{ticket.current++},[]);useEffect(()=>{if(disabled)ticket.current++},[disabled]);
 async function prepare(body:PreparedDraftBody|PreparedRevisionBody){const n=++ticket.current;try{const input={kind,arguments:body} as BusinessDraft;const v=await api<BusinessDraft>('/conversations/'+c.id+'/business-drafts/prepare',{method:'POST',body:input});if(n!==ticket.current||blocked.current)throw new Error('请求状态已变化，请重新整理本次资料。');if(v.kind!==kind||v.arguments.project_id!==c.project_id||v.arguments.classification!==c.classification)throw new Error('服务端整理范围与本次会话不一致。');setPrepared(v);setReviewed(false);setEditor(false);setError(undefined);}catch(e){setError(e);throw e;}}
 return <section className="conversation-source-preview"><h4>使用完整业务表单</h4><p>填写合同条款、收付款计划、采购／报销明细和凭证，或订阅日历及价格。预览阶段不会创建业务记录；确认加入请求后，再由秘书按固定资料保存。</p><ErrorNotice error={error}/><Field label="完整草稿业务类型"><select disabled={disabled} value={kind} onChange={e=>{ticket.current++;setKind(e.target.value as DraftKind);setPrepared(undefined);setReviewed(false);}}>{Object.entries(draftNames).map(([v,n])=><option key={v} value={v}>{n}</option>)}</select></Field><button type="button" className="button secondary" disabled={disabled} onClick={()=>setEditor(true)}>整理完整{draftNames[kind]}资料</button>{prepared&&<><FieldChanges before={{}} after={businessContent(prepared.arguments)}/><p>操作依据：{prepared.arguments.reason}</p><label className="check-field"><input type="checkbox" disabled={disabled} checked={reviewed} onChange={e=>setReviewed(e.target.checked)}/>我已核对整理后的全部资料及固定引用</label><button type="button" className="button secondary" disabled={disabled||!reviewed} onClick={()=>{onChange(prepared);setPrepared(undefined);setReviewed(false);}}>将完整草稿资料加入请求</button></>}{editor&&<DraftEditor kind={kind} me={me} conversation={c} onPrepared={prepare} onClose={()=>{ticket.current++;setEditor(false);}}/>}</section>;
}
export function ConversationBusinessRevision({conversation:c,me,disabled,value,onChange}:{conversation:Schemas['Conversation'];me:Me;disabled:boolean;value?:BusinessRevision;onChange(v?:BusinessRevision):void}){
 const[kind,setKind]=useState<DraftKind>('contract'),[picking,setPicking]=useState(false),[basis,setBasis]=useState<RevisionBasis>(),[record,setRecord]=useState<BusinessRecord>(),[prepared,setPrepared]=useState<PreparedBusinessRevision>(),[scopeReviewed,setScopeReviewed]=useState(false),[reviewed,setReviewed]=useState(false),[editor,setEditor]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState<unknown>();
 const ticket=useRef(0),blocked=useRef(disabled);blocked.current=disabled;useEffect(()=>()=>{ticket.current++},[]);useEffect(()=>{if(disabled)ticket.current++},[disabled]);
 const records=useInfiniteQuery({queryKey:['secretary-revision-picker',c.id,kind],enabled:picking&&!disabled,initialPageParam:'',queryFn:({pageParam,signal})=>api<Page<BusinessRecord>>(businessRoutes[kind]+'?'+new URLSearchParams({limit:'30',...(pageParam?{cursor:pageParam}:{})}),{signal}),getNextPageParam:p=>p.next_cursor??undefined});
 if(c.type!=='private'||c.creator_id!==me.user.id)return null;
 async function select(id:string){const n=++ticket.current;setBusy(true);setError(undefined);setPrepared(undefined);setReviewed(false);setScopeReviewed(false);try{const[b,r]=await Promise.all([api<RevisionBasis>('/conversations/'+c.id+'/business-revisions/'+kind+'/'+id),api<BusinessRecord>(businessRoutes[kind]+'/'+id)]);if(n!==ticket.current||blocked.current)return;if(b.kind!==kind||b.id!==id||r.id!==id||b.version!==r.version||b.revision_id!==r.current_revision_id||b.content_hash!==r.content_hash||b.project_id!==r.project_id||b.classification!==r.classification)throw new Error('读取期间业务版本已变化，请重新选择。');setBasis(b);setRecord(r);setPicking(false);}catch(e){if(n===ticket.current)setError(e);}finally{if(n===ticket.current)setBusy(false);}}
 async function prepare(body:PreparedDraftBody|PreparedRevisionBody){if(!basis)throw new Error('请先选择准确业务版本。');const n=++ticket.current;try{const input=makeBusinessRevision(basis,body as PreparedRevisionBody,scopeReviewed);const v=await api<PreparedBusinessRevision>('/conversations/'+c.id+'/business-revisions/prepare',{method:'POST',body:input});if(n!==ticket.current||blocked.current)throw new Error('请求状态已变化，请重新整理。');if(!preparedRevisionMatches(v,input))throw new Error('修订整理回执未固定当前版本与范围。');setPrepared(v);setReviewed(false);setEditor(false);setError(undefined);}catch(e){setError(e);throw e;}}
 return <section className="conversation-source-preview"><h4>修改现有业务草稿</h4><p>选择当前普通草稿，使用完整表单整理准确修改，再单独授权本次秘书执行。已生效业务、订阅启用、审批、费用与付款须分别办理。</p><ErrorNotice error={error}/>{value&&<><p>已加入固定修订：{draftNames[value.kind]} · 版本{value.expected_version}</p><button type="button" className="text-button" disabled={disabled} onClick={()=>onChange(undefined)}>移除本次业务修订授权</button></>}<Field label="现有草稿业务类型"><select disabled={disabled||busy} value={kind} onChange={e=>{ticket.current++;setKind(e.target.value as DraftKind);setBasis(undefined);setRecord(undefined);setPrepared(undefined);setReviewed(false);setScopeReviewed(false);}}>{Object.entries(draftNames).map(([v,n])=><option key={v} value={v}>{n}</option>)}</select></Field><button type="button" className="button secondary" disabled={disabled||busy} onClick={()=>setPicking(true)}>选择现有{draftNames[kind]}草稿</button>{basis&&record&&<><p>准确依据：{basis.title} · 版本{basis.version} · {basis.project_id?'项目资料':'公司资料'} · {basis.classification==='internal'?'内部':'项目受限'}</p><Link to={businessRoutes[kind]+'/'+basis.id}>打开现有业务记录核对</Link>{basis.cross_scope&&<label className="check-field"><input type="checkbox" disabled={disabled||busy} checked={scopeReviewed} onChange={e=>{ticket.current++;setScopeReviewed(e.target.checked);setPrepared(undefined);setReviewed(false);}}/>本次对象的项目或分类与会话不同；我单独批准此准确目标范围的草稿修订，不授权其他对象或操作</label>}<button type="button" className="button secondary" disabled={disabled||busy||basis.cross_scope&&!scopeReviewed} onClick={()=>setEditor(true)}>整理此草稿的准确修改</button></>}{prepared&&<><FieldChanges before={prepared.basis.content} after={businessContent(prepared.input.arguments)}/><p>操作依据：{prepared.input.arguments.reason}</p><label className="check-field"><input type="checkbox" disabled={disabled} checked={reviewed} onChange={e=>setReviewed(e.target.checked)}/>我已核对全部前后资料及固定引用，并授权保存此准确新修订；发送时须通过两步验证</label><button type="button" className="button secondary" disabled={disabled||!reviewed} onClick={()=>{onChange(prepared.input);setPrepared(undefined);setReviewed(false);}}>将准确业务修订加入请求</button></>}{editor&&record&&<DraftEditor key={record.id+':'+record.version} kind={kind} me={me} conversation={c} record={record} onPrepared={prepare} onClose={()=>{ticket.current++;setEditor(false);}}/>}{picking&&<Dialog title={'选择现有'+draftNames[kind]+'草稿'} onClose={()=>{ticket.current++;setPicking(false);setBusy(false);}} busy={busy}><ErrorNotice error={records.error}/>{!records.error&&records.data?.pages.flatMap(p=>p.items).map(r=><button type="button" className="button secondary" key={r.id} disabled={busy} onClick={()=>void select(r.id)}>{'title'in r?r.title:r.product} · 版本{r.version}</button>)}{records.isPending&&<p>正在读取当前可访问记录。</p>}{records.hasNextPage&&<button type="button" disabled={records.isFetchingNextPage||busy} onClick={()=>void records.fetchNextPage()}>加载更多业务记录</button>}<p>这里只显示普通权限允许访问的记录；能否修订仍以当前阶段、AI处理权限及准确范围检查为准。</p></Dialog>}</section>;
}
export function BusinessRevisionReceipt({run}:{run:Schemas['Run']}){const v=run.business_revision;if(!v)return null;const ok=businessRevisionReceipt(run);return <section className="conversation-source-preview"><h4>{draftNames[v.input.kind]}草稿修订记录</h4>{ok&&v.result?<><p>普通业务新修订已保存 · 版本{v.result.version}</p><p className="record-code">操作 {v.operation_id}</p><Link to={businessRoutes[v.input.kind]+'/'+v.input.resource_id}>查阅准确业务新修订并继续办理</Link></>:<p>已记录准确原版本、全部修订资料和本人范围确认，执行后请核对正式业务回执。</p>}<p className="muted">此授权仅覆盖这份固定草稿修订；审批、生效、费用和现金仍须独立办理。</p></section>;}

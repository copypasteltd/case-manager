// Actual UI, native API, PG and controlled exact objects. No response replacement.
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { mkdir, readFile, writeFile } from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { officeTextBrowser, waitOTP } from './office_text_browser_common.mjs';
import { mobileScreen, selectMobile } from './mobile_picker_browser.mjs';
import { assertNoCredentials, recordViewport } from './office_text_recording.mjs';

const app = fileURLToPath(new URL('../', import.meta.url)), mobile = process.argv.includes('--mobile');
const sha = value => createHash('sha256').update(value).digest('hex');
await officeTextBrowser(mobile, async ({ page, context, fixture, checks, evidence }) => {
  assert.ok(fixture.office_text_fixture && fixture.isolated_database);
  const root = () => mobile ? mobileScreen(page) : page;
  const field = label => mobile ? root().locator('input[aria-label="' + label + '"],textarea[aria-label="' + label + '"]') : page.getByLabel(label, { exact: true });
  const button = name => root().getByRole('button', { name, exact: true });
  let bearer;
  page.on('request', request => { if (request.headers().authorization?.startsWith('Bearer ')) bearer = request.headers().authorization; });
  await page.goto(fixture.origin); await field('内部账号').fill(fixture.alice.login); await field('密码').fill(fixture.alice.password);
  await button(mobile ? '登录工作空间 ↗' : '登录工作空间').click(); await field('六位验证码').fill(await waitOTP(fixture));
  await button(mobile ? '验证并继续 ↗' : '验证并继续').click();
  if (mobile) await root().locator('.cp-title').filter({ hasText: '工作从这里开始' }).waitFor(); else await page.getByRole('heading', { name: /工作从这里开始/ }).waitFor();
  const origin = mobile ? fixture.api_origin : fixture.origin;
  async function get(route) { const response = await context.request.get(origin + '/v1' + route, { headers: mobile ? { Authorization: bearer } : {} }); assert.equal(response.status(), 200, route); return (await response.json()).data; }
  await page.goto(fixture.origin + (mobile ? '/#/pages/search/index' : '/search'));
  await field('搜索工作资料').fill('香港Office');
  const searching = page.waitForResponse(r => new URL(r.url()).pathname === '/v1/search');
  await button('搜索资料').click(); const search = await searching; assert.equal(search.status(), 200);
  const hits = (await search.json()).data.items; assert.equal(hits.length, 3);
  assert.ok(hits.some(h => h.resource.id === fixture.file_id && h.resource.version_id === fixture.target_version_id));
  checks.push('Actual search includes current Office bodies once and pins the current XLSX version, excluding its older body and legacy unsupported derivation.');
  const shots = [], documents = [], directory = path.join(app, '../docs/media/screenshots'); await mkdir(directory, { recursive: true });
  const prefix = 'office-text-' + (mobile ? 'mobile' : 'web');
  async function shot(name) { await assertNoCredentials(page); const file = prefix + '-' + name + '.png'; await page.screenshot({ path: path.join(directory, file) }); shots.push({ file: 'docs/media/screenshots/' + file, sha256: sha(await readFile(path.join(directory, file))) }); }
  const recording = await recordViewport(page, app, prefix, async () => {
    for (const [title, file, version, expected] of [['项目预算.xlsx', fixture.file_id, fixture.target_version_id, '公式（未计算）'], ['季度交付.pptx', fixture.presentation_file_id, fixture.presentation_version_id, '讲者备注：核对当前交付安排。']]) {
      const hit = root().locator(mobile ? '.cp-search-hit' : '.search-hit').filter({ has: root().getByText(title, { exact: true }) });
      const response = page.waitForResponse(r => new URL(r.url()).pathname === '/v1/files/' + file + '/versions/' + version + '/text');
      await hit.getByRole('button', { name: '查阅此版本正文', exact: true }).click(); const result = await response; assert.equal(result.status(), 200);
      const body = (await result.json()).data; assert.equal(body.extractor, 'office-v1'); assert.equal(body.version_id, version); assert.equal(sha(body.text), body.text_sha256); assert.equal(body.next_offset, null);
      const preview = mobile ? root().locator('.cp-section').filter({ has: root().getByText(title + ' · 正文', { exact: true }) }) : page.getByRole('region', { name: '固定版本正文', exact: true });
      await preview.getByText(/Office 正文为文字提取/).waitFor(); await preview.getByText(new RegExp(expected)).waitFor();
      if (title.endsWith('xlsx')) { assert.ok(body.text.includes('状态=hidden')); assert.ok(body.text.includes('可能过期')); }
      documents.push({ file_id: file, version_id: version, extractor: body.extractor, source_sha256: body.source_sha256, text_sha256: body.text_sha256 });
      await preview.scrollIntoViewIfNeeded(); await shot(title.endsWith('xlsx') ? 'xlsx' : 'pptx'); await button('关闭正文').click();
    }
    checks.push('The real XLSX preview labels hidden sheet and unevaluated formula cache; the PPTX preview contains actual slide prose and speaker notes, with exact complete text hashes.');
    const versions = (await get('/files/' + fixture.file_id + '/versions')).items;
    await page.goto(fixture.origin + (mobile ? '/#/pages/files/index?file_id=' : '/files/') + fixture.file_id);
    const panel = mobile ? root().locator('.cp-section').filter({ hasText: '比较两个内容版本' }) : page.getByRole('region', { name: '文件版本正文比较', exact: true });
    await panel.waitFor();
    for (const [label, id] of [['比较基础版本', fixture.base_version_id], ['比较目标版本', fixture.target_version_id]]) {
      if (mobile) await selectMobile(page, label, '内容版本 ' + versions.find(v => v.id === id).seq + ' · ' + id.slice(0, 8)); else await page.getByLabel(label, { exact: true }).selectOption(id);
    }
    const response = page.waitForResponse(r => new URL(r.url()).pathname.endsWith('/text-comparison'));
    await button('比较所选版本').click(); const result = await response; assert.equal(result.status(), 200); const comparison = (await result.json()).data;
    assert.equal(comparison.extractor, 'office-v1'); assert.equal(comparison.base.extractor, 'office-v1'); assert.equal(comparison.target.extractor, 'office-v1'); assert.equal(comparison.text_equal, false); assert.ok(comparison.rows.some(r => r.text.includes('香港Office当前预算')));
    await panel.getByText('内容版本 1 → 2', { exact: true }).waitFor(); await panel.scrollIntoViewIfNeeded(); await shot('comparison');
    if (!mobile) { await page.getByLabel('外观偏好', { exact: true }).selectOption('dark'); await shot('dark'); await page.getByLabel('外观偏好', { exact: true }).selectOption('light'); }
    checks.push('Actual exact-version comparison presents XLSX changes and binds office-v1 independently on both formal versions, with extraction limitations visible.');
    const conversation = await get('/conversations/' + fixture.conversation_id);
    const preview = await get('/conversations/' + fixture.conversation_id + '/context-sources/file/' + fixture.presentation_file_id + '?context_security_version=' + conversation.context_security_version + '&version_id=' + fixture.presentation_version_id + '&max_chars=10000');
    assert.equal(preview.text_index.extractor, 'office-v1'); assert.equal(preview.text_index.text_sha256, documents[1].text_sha256); assert.ok(preview.text.includes('讲者备注'));
    checks.push('The authenticated secretary-source API returns the exact same immutable PPTX derivation after object credentials were removed; this is source retrieval, not real-model acceptance.');
  });
  const layouts = [];
  for (const width of mobile ? [390] : [1440,390]) { await page.setViewportSize({ width, height:900 }); const size = await (mobile ? root() : page.locator('html')).evaluate(node => ({ width: node.clientWidth, scroll: node.scrollWidth })); assert.ok(size.scroll <= size.width + 1); layouts.push({ width,...size,passed:true }); }
  checks.push('Owned browser pages render at the declared viewport sizes without horizontal overflow; all contexts and temporary servers are closed by the runner.');
  await writeFile(path.join(evidence,'capture.json'), JSON.stringify({ screenshots:shots,recordings:[recording],documents,layouts,synthetic_data:true,real_model:false,real_cloud:false }, null, 2)+'\n');
});
